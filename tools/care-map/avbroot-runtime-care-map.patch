+/// Parse Android half-open block ranges without accepting ambiguous spellings.
+pub fn parse_ranges(value: &str) -> Result<Vec<std::ops::Range<u64>>> {
+    let values = value
+        .split(',')
+        .map(|v| {
+            if v.is_empty()
+                || !v.bytes().all(|b| b.is_ascii_digit())
+                || (v.len() > 1 && v.starts_with('0'))
+            {
+                return Err(Error::InvalidExpected("Noncanonical range integer".into()));
+            }
+            v.parse::<u64>()
+                .map_err(|_| Error::InvalidExpected("Range integer overflow".into()))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    if values.len() < 3 || values[0] != (values.len() - 1) as u64 || values[0] % 2 != 0 {
+        return Err(Error::InvalidExpected(
+            "Invalid or empty range count".into(),
+        ));
+    }
+    let mut result = Vec::new();
+    let mut previous_end = 0;
+    for pair in values[1..].chunks_exact(2) {
+        if pair[0] >= pair[1] || pair[0] < previous_end {
+            return Err(Error::InvalidExpected(
+                "Empty, overlapping or unsorted ranges".into(),
+            ));
+        }
+        result.push(pair[0]..pair[1]);
+        previous_end = pair[1];
+    }
+    Ok(result)
+}
+
+/// Validate an externally proven filesystem/runtime map against AVB-derived
+/// bounds and the payload's actual deterministic writes. This deliberately does
+/// not infer runtime fingerprints from AVB properties. The caller must prove
+/// filesystem identities separately; this function never disables authentication.
+pub fn validate_expected(
+    expected: &CareMap,
+    bounds: &CareMap,
+    header: &PayloadHeader,
+) -> Result<()> {
+    // Android update_verifier interprets care-map blocks as 4096-byte blocks.
+    if header.manifest.block_size() != 4096 {
+        return Err(Error::InvalidExpected(
+            "Unsupported care-map block size".into(),
+        ));
+    }
+    if expected.partitions.is_empty() || expected.partitions.len() != bounds.partitions.len() {
+        return Err(Error::InvalidExpected("Missing required partitions".into()));
+    }
+    let mut seen = HashSet::new();
+    for entry in &expected.partitions {
+        if !seen.insert(&entry.name) {
+            return Err(Error::InvalidExpected(format!(
+                "Duplicate partition: {}",
+                entry.name
+            )));
+        }
+        let bound = bounds
+            .partitions
+            .iter()
+            .find(|p| p.name == entry.name)
+            .ok_or_else(|| {
+                Error::InvalidExpected(format!("Unexpected partition: {}", entry.name))
+            })?;
+        if entry.id != format!("ro.{}.build.fingerprint", entry.name)
+            || entry.fingerprint.is_empty()
+            || entry.fingerprint == "unknown"
+        {
+            return Err(Error::InvalidExpected(format!(
+                "Invalid runtime identity: {}",
+                entry.name
+            )));
+        }
+        let limits = parse_ranges(&bound.ranges)?;
+        let ranges = parse_ranges(&entry.ranges)?;
+        let max_block = limits.last().unwrap().end;
+        if ranges.iter().any(|r| r.end > max_block) {
+            return Err(Error::InvalidExpected(format!(
+                "Ranges exceed AVB-protected data: {}",
+                entry.name
+            )));
+        }
+        let partition = header
+            .manifest
+            .partitions
+            .iter()
+            .find(|p| p.partition_name == entry.name)
+            .ok_or_else(|| Error::MissingPartition(entry.name.clone()))?;
+        let image_size = partition
+            .new_partition_info
+            .as_ref()
+            .and_then(|p| p.size)
+            .ok_or_else(|| Error::InvalidExpected("Missing partition size".into()))?;
+        let mut writes = Vec::new();
+        for operation in &partition.operations {
+            let deterministic = matches!(
+                Type::try_from(operation.r#type),
+                Ok(Type::Replace | Type::ReplaceBz | Type::ReplaceXz | Type::Zero)
+            );
+            for extent in &operation.dst_extents {
+                let start = extent
+                    .start_block
+                    .ok_or_else(|| Error::InvalidExpected("Missing extent start".into()))?;
+                let end = start
+                    .checked_add(
+                        extent
+                            .num_blocks
+                            .ok_or_else(|| Error::InvalidExpected("Missing extent count".into()))?,
+                    )
+                    .ok_or_else(|| Error::InvalidExpected("Extent overflow".into()))?;
+                if end
+                    .checked_mul(u64::from(header.manifest.block_size()))
+                    .is_none_or(|size| size > image_size)
+                {
+                    return Err(Error::InvalidExpected("Operation outside partition".into()));
+                }
+                if !deterministic && ranges.iter().any(|r| r.start < end && start < r.end) {
+                    return Err(Error::InvalidExpected(format!(
+                        "Nondeterministic cared blocks: {}",
+                        entry.name
+                    )));
+                }
+                if deterministic {
+                    writes.push(start..end);
+                }
+            }
+        }
+        writes.sort_by_key(|r| r.start);
+        let mut previous_end = 0;
+        for write in &writes {
+            let overlap_end = previous_end.min(write.end);
+            if ranges.iter().any(|range| {
+                range.start < overlap_end && write.start < range.end && write.start < overlap_end
+            }) {
+                return Err(Error::InvalidExpected(format!(
+                    "Overlapping cared writes: {}",
+                    entry.name
+                )));
+            }
+            previous_end = previous_end.max(write.end);
+        }
+        for range in ranges {
+            let mut cursor = range.start;
+            for write in &writes {
+                if write.start > cursor {
+                    break;
+                }
+                if write.end > cursor {
+                    cursor = write.end;
+                }
+                if cursor >= range.end {
+                    break;
+                }
+            }
+            if cursor < range.end {
+                return Err(Error::InvalidExpected(format!(
+                    "Unwritten cared blocks: {}",
+                    entry.name
+                )));
+            }
+        }
+    }
+    Ok(())
+}
