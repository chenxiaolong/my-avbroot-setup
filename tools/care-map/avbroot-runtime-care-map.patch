@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Independent range-policy boundary tests. Authentication is tested separately.
+use avbroot::{
+    format::{care_map::validate_expected, payload::PayloadHeader},
+    protobuf::{
+        chromeos_update_engine::{
+            DeltaArchiveManifest, Extent, InstallOperation, PartitionInfo as PayloadPartitionInfo,
+            PartitionUpdate, install_operation::Type,
+        },
+        recovery_update_verifier::{CareMap, care_map::PartitionInfo},
+    },
+};
+
+fn map(ranges: &str) -> CareMap {
+    CareMap {
+        partitions: vec![PartitionInfo {
+            name: "system".into(),
+            ranges: ranges.into(),
+            id: "ro.system.build.fingerprint".into(),
+            fingerprint: "runtime/filesystem/fingerprint".into(),
+        }],
+        ..Default::default()
+    }
+}
+
+fn op(kind: Type, start: u64, blocks: u64) -> InstallOperation {
+    InstallOperation {
+        r#type: kind as i32,
+        dst_extents: vec![Extent {
+            start_block: Some(start),
+            num_blocks: Some(blocks),
+        }],
+        ..Default::default()
+    }
+}
+
+fn header(operations: Vec<InstallOperation>) -> PayloadHeader {
+    PayloadHeader {
+        version: 2,
+        metadata_signature_size: 0,
+        blob_offset: 0,
+        manifest: DeltaArchiveManifest {
+            block_size: Some(4096),
+            partitions: vec![PartitionUpdate {
+                partition_name: "system".into(),
+                operations,
+                new_partition_info: Some(PayloadPartitionInfo {
+                    size: Some(10 * 4096),
+                    hash: Some(vec![0; 32]),
+                }),
+                ..Default::default()
+            }],
+            ..Default::default()
+        },
+    }
+}
+
+#[test]
+fn deterministic_new_allocations_can_expand_beyond_original_sparse_map() {
+    // Source cared only blocks 0..2 and 4..6. A modified-image REPLACE_XZ
+    // writes every final data block, allowing new APK data in former holes.
+    let payload = header(vec![op(Type::ReplaceXz, 0, 8)]);
+    validate_expected(&map("2,0,8"), &map("2,0,8"), &payload).unwrap();
+}
+
+#[test]
+fn authenticated_sparse_holes_can_remain_uncared() {
+    let payload = header(vec![
+        op(Type::Replace, 0, 2),
+        op(Type::Discard, 2, 2),
+        op(Type::Zero, 4, 4),
+    ]);
+    validate_expected(&map("4,0,2,4,8"), &map("2,0,8"), &payload).unwrap();
+    assert!(validate_expected(&map("2,0,8"), &map("2,0,8"), &payload).is_err());
+}
+
+#[test]
+fn a_gap_or_source_dependent_write_cannot_become_cared() {
+    for operations in [
+        vec![op(Type::ReplaceXz, 0, 3), op(Type::Zero, 4, 4)],
+        vec![op(Type::Replace, 0, 4), op(Type::SourceCopy, 4, 4)],
+        vec![op(Type::Replace, 0, 8), op(Type::Discard, 4, 1)],
+        vec![op(Type::Replace, 0, 8), op(Type::ReplaceXz, 4, 1)],
+    ] {
+        assert!(validate_expected(&map("2,0,8"), &map("2,0,8"), &header(operations)).is_err());
+    }
+}
+
+#[test]
+fn trailer_and_wrong_runtime_property_are_rejected() {
+    let payload = header(vec![op(Type::ReplaceXz, 0, 10)]);
+    assert!(validate_expected(&map("2,0,9"), &map("2,0,8"), &payload).is_err());
+    let mut wrong = map("2,0,8");
+    wrong.partitions[0].id = "ro.product.build.fingerprint".into();
+    assert!(validate_expected(&wrong, &map("2,0,8"), &payload).is_err());
+    wrong = map("2,0,8");
+    wrong.partitions[0].fingerprint = "unknown".into();
+    assert!(validate_expected(&wrong, &map("2,0,8"), &payload).is_err());
+}
+
+#[test]
+fn omission_duplicate_and_unknown_partition_are_rejected() {
+    let payload = header(vec![op(Type::Replace, 0, 8)]);
+    let bound = map("2,0,8");
+    let mut bad = bound.clone();
+    bad.partitions.clear();
+    assert!(validate_expected(&bad, &bound, &payload).is_err());
+    bad = bound.clone();
+    bad.partitions.push(bad.partitions[0].clone());
+    assert!(validate_expected(&bad, &bound, &payload).is_err());
+    bad = bound.clone();
+    bad.partitions[0].name = "product".into();
+    assert!(validate_expected(&bad, &bound, &payload).is_err());
+}
+
+#[test]
+fn malformed_ranges_and_invalid_extent_units_are_rejected() {
+    let payload = header(vec![op(Type::ReplaceXz, 0, 8)]);
+    for ranges in ["0", "4,0,3,2,6", "2,0,03", "2,0,18446744073709551616"] {
+        assert!(validate_expected(&map(ranges), &map("2,0,8"), &payload).is_err());
+    }
+    let mut unknown = payload.clone();
+    unknown.manifest.partitions[0].operations[0].r#type = 999;
+    assert!(validate_expected(&map("2,0,8"), &map("2,0,8"), &unknown).is_err());
+    let mut overflow = payload.clone();
+    overflow.manifest.partitions[0].operations[0].dst_extents[0].num_blocks = Some(u64::MAX);
+    assert!(validate_expected(&map("2,0,8"), &map("2,0,8"), &overflow).is_err());
+    let mut wrong_units = payload.clone();
+    wrong_units.manifest.block_size = Some(8192);
+    assert!(validate_expected(&map("2,0,8"), &map("2,0,8"), &wrong_units).is_err());
+}
