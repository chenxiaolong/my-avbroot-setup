+#[test]
+fn unsigned_header_cannot_satisfy_explicit_signer_trust() {
+    use avbroot::cli::avb::{ImageOpener, TrustMethod, verify_headers};
+    use std::collections::{HashMap, HashSet};
+    let directory = tempfile::tempdir().unwrap();
+    let header = Header {
+        required_libavb_version_major: 1,
+        required_libavb_version_minor: 0,
+        algorithm_type: AlgorithmType::None,
+        hash: vec![],
+        signature: vec![],
+        public_key: vec![],
+        public_key_metadata: vec![],
+        descriptors: vec![],
+        rollback_index: 0,
+        flags: 0,
+        rollback_index_location: 0,
+        release_string: String::new(),
+        reserved: [0; 80],
+    };
+    let mut image = std::fs::File::create(directory.path().join("vbmeta.img")).unwrap();
+    avb::write_root_image(&mut image, &header, 4096).unwrap();
+    let opener = ImageOpener::with_dir(directory.path());
+    verify_headers(
+        &opener,
+        "vbmeta",
+        &TrustMethod::Anything,
+        &mut HashSet::new(),
+        &mut HashMap::new(),
+    )
+    .unwrap();
+    for trust in [
+        TrustMethod::KeyDigest([0; 32]),
+        TrustMethod::Key(get_test_key_rsa().to_public_key()),
+    ] {
+        assert!(
+            verify_headers(
+                &opener,
+                "vbmeta",
+                &trust,
+                &mut HashSet::new(),
+                &mut HashMap::new()
+            )
+            .is_err()
+        );
+    }
+}
